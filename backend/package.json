{
  "name": "parqueadero-app-backend",
  "version": "1.0.0",
  "description": "Backend API for parking management system using layered architecture",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:horarios": "NODE_OPTIONS=--experimental-vm-modules jest tests/horarios.test.js",
    "test:entrada-salida": "NODE_OPTIONS=--experimental-vm-modules jest tests/entrada-salida.test.js",
    "test:tarifas": "NODE_OPTIONS=--experimental-vm-modules jest tests/tarifas.test.js",
    "test:logica": "NODE_OPTIONS=--experimental-vm-modules jest tests/logica-negocio.test.js",
    "test:all": "NODE_OPTIONS=--experimental-vm-modules jest tests/"
  },
  "keywords": ["parking", "express", "sequelize", "postgresql", "layered-architecture"],
  "author": "David",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "sequelize": "^6.32.1",
    "pg": "^8.11.3",
    "mqtt": "^5.3.0",
    "aedes": "^0.50.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.2"
  }
}